# 데이터베이스 설정
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_secure_password>
POSTGRES_DB=pcode_db

# 백엔드 설정
# 프로덕션 환경에서는 아래 값을 변경하세요
FLASK_ENV=production
FLASK_DEBUG=0
DB_HOST=db
DB_NAME=pcode_db
DB_USER=postgres
DB_PASSWORD=<your_secure_password>
SECRET_KEY=<your_random_secret_key>

# 도메인 설정
DOMAIN=<your_domain>
ALLOWED_HOSTS=localhost,127.0.0.1,<your_domain>

# NGINX 설정
NGINX_PORT=80
NGINX_SSL_PORT=443

# CTFd 설정
CTFD_SECRET_KEY=<your_random_secret_key>
CTFD_DATABASE_URL=mysql+pymysql://ctfd:<password>@db/ctfd 